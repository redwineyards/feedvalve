package main

/*
#cgo LDFLAGS: -llzo2
#include <lzo/lzoconf.h>
#include <lzo/lzo1z.h>

static int feedvalve_lzo_init(void) {
	return lzo_init();
}

static int feedvalve_lzo1z_decompress(const lzo_bytep src, lzo_uint src_len,
                                       lzo_bytep dst, lzo_uintp dst_len) {
	return lzo1z_decompress(src, src_len, dst, dst_len, NULL);
}
*/
import "C"

import (
	"fmt"
	"unsafe"
)

// lzoInit wraps lzo_init(). It must be called once, before the first call to
// lzo1zDecompress.
func lzoInit() error {
	if rc := C.feedvalve_lzo_init(); rc != C.LZO_E_OK {
		return fmt.Errorf("lzo_init failed: rc=%d", int(rc))
	}
	return nil
}

// lzo1zDecompress wraps the lzo1z_decompress function from lzo1z.h. It
// decompresses src into dst and returns the portion of dst holding the
// decompressed data. dst must be large enough to hold the decompressed
// output.
func lzo1zDecompress(dst, src []byte) ([]byte, error) {
	if len(src) == 0 {
		return nil, fmt.Errorf("lzo1zDecompress: empty input")
	}
	if len(dst) == 0 {
		return nil, fmt.Errorf("lzo1zDecompress: empty destination buffer")
	}

	dstLen := C.lzo_uint(len(dst))

	rc := C.feedvalve_lzo1z_decompress(
		(C.lzo_bytep)(unsafe.Pointer(&src[0])),
		C.lzo_uint(len(src)),
		(C.lzo_bytep)(unsafe.Pointer(&dst[0])),
		&dstLen,
	)
	switch rc {
	case C.LZO_E_OK:
		return dst[:int(dstLen)], nil
	case C.LZO_E_OUTPUT_OVERRUN:
		return nil, fmt.Errorf("lzo1z_decompress: destination buffer too small (%d bytes)", len(dst))
	default:
		return nil, fmt.Errorf("lzo1z_decompress failed: rc=%d", int(rc))
	}
}

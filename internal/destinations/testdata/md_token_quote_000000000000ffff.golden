MERGE INTO MD_TOKEN_QUOTE t
USING (SELECT
  :1 AS token,
  :2 AS last_traded_price,
  :3 AS volume_traded_today,
  :4 AS open_price,
  :5 AS high_price,
  :6 AS low_price,
  :7 AS closing_price,
  :8 AS trading_status,
  :9 AS net_change_indicator,
  :10 AS last_trade_quantity,
  :11 AS last_trade_time,
  :12 AS average_trade_price,
  :13 AS total_buy_quantity,
  :14 AS total_sell_quantity,
  :15 AS book_type,
  :16 AS bid_qty_1,
  :17 AS bid_px_1,
  :18 AS bid_ord_1,
  :19 AS bid_qty_2,
  :20 AS bid_px_2,
  :21 AS bid_ord_2,
  :22 AS bid_qty_3,
  :23 AS bid_px_3,
  :24 AS bid_ord_3,
  :25 AS bid_qty_4,
  :26 AS bid_px_4,
  :27 AS bid_ord_4,
  :28 AS bid_qty_5,
  :29 AS bid_px_5,
  :30 AS bid_ord_5,
  :31 AS ask_qty_1,
  :32 AS ask_px_1,
  :33 AS ask_ord_1,
  :34 AS ask_qty_2,
  :35 AS ask_px_2,
  :36 AS ask_ord_2,
  :37 AS ask_qty_3,
  :38 AS ask_px_3,
  :39 AS ask_ord_3,
  :40 AS ask_qty_4,
  :41 AS ask_px_4,
  :42 AS ask_ord_4,
  :43 AS ask_qty_5,
  :44 AS ask_px_5,
  :45 AS ask_ord_5,
  :46 AS effective_ts,
  :47 AS updated_at
  FROM dual) s
ON (t.token = s.token)
WHEN MATCHED THEN UPDATE SET
  t.last_traded_price = s.last_traded_price / 100,
  t.volume_traded_today = s.volume_traded_today,
  t.open_price = s.open_price / 100,
  t.high_price = s.high_price / 100,
  t.low_price = s.low_price / 100,
  t.closing_price = s.closing_price / 100,
  t.trading_status = s.trading_status,
  t.net_change_indicator = s.net_change_indicator,
  t.last_trade_quantity = s.last_trade_quantity,
  t.last_trade_time = s.last_trade_time,
  t.average_trade_price = s.average_trade_price / 100,
  t.total_buy_quantity = s.total_buy_quantity,
  t.total_sell_quantity = s.total_sell_quantity,
  t.book_type = s.book_type,
  t.bid_qty_1 = s.bid_qty_1,
  t.bid_px_1 = s.bid_px_1 / 100,
  t.bid_ord_1 = s.bid_ord_1,
  t.bid_qty_2 = s.bid_qty_2,
  t.bid_px_2 = s.bid_px_2 / 100,
  t.bid_ord_2 = s.bid_ord_2,
  t.bid_qty_3 = s.bid_qty_3,
  t.bid_px_3 = s.bid_px_3 / 100,
  t.bid_ord_3 = s.bid_ord_3,
  t.bid_qty_4 = s.bid_qty_4,
  t.bid_px_4 = s.bid_px_4 / 100,
  t.bid_ord_4 = s.bid_ord_4,
  t.bid_qty_5 = s.bid_qty_5,
  t.bid_px_5 = s.bid_px_5 / 100,
  t.bid_ord_5 = s.bid_ord_5,
  t.ask_qty_1 = s.ask_qty_1,
  t.ask_px_1 = s.ask_px_1 / 100,
  t.ask_ord_1 = s.ask_ord_1,
  t.ask_qty_2 = s.ask_qty_2,
  t.ask_px_2 = s.ask_px_2 / 100,
  t.ask_ord_2 = s.ask_ord_2,
  t.ask_qty_3 = s.ask_qty_3,
  t.ask_px_3 = s.ask_px_3 / 100,
  t.ask_ord_3 = s.ask_ord_3,
  t.ask_qty_4 = s.ask_qty_4,
  t.ask_px_4 = s.ask_px_4 / 100,
  t.ask_ord_4 = s.ask_ord_4,
  t.ask_qty_5 = s.ask_qty_5,
  t.ask_px_5 = s.ask_px_5 / 100,
  t.ask_ord_5 = s.ask_ord_5,
  t.effective_ts = s.effective_ts,
  t.updated_at = s.updated_at
WHEN NOT MATCHED THEN INSERT (
  token,
  last_traded_price,
  volume_traded_today,
  open_price,
  high_price,
  low_price,
  closing_price,
  trading_status,
  net_change_indicator,
  last_trade_quantity,
  last_trade_time,
  average_trade_price,
  total_buy_quantity,
  total_sell_quantity,
  book_type,
  bid_qty_1,
  bid_px_1,
  bid_ord_1,
  bid_qty_2,
  bid_px_2,
  bid_ord_2,
  bid_qty_3,
  bid_px_3,
  bid_ord_3,
  bid_qty_4,
  bid_px_4,
  bid_ord_4,
  bid_qty_5,
  bid_px_5,
  bid_ord_5,
  ask_qty_1,
  ask_px_1,
  ask_ord_1,
  ask_qty_2,
  ask_px_2,
  ask_ord_2,
  ask_qty_3,
  ask_px_3,
  ask_ord_3,
  ask_qty_4,
  ask_px_4,
  ask_ord_4,
  ask_qty_5,
  ask_px_5,
  ask_ord_5,
  effective_ts,
  updated_at
)
VALUES (
  s.token,
  s.last_traded_price / 100,
  s.volume_traded_today,
  s.open_price / 100,
  s.high_price / 100,
  s.low_price / 100,
  s.closing_price / 100,
  s.trading_status,
  s.net_change_indicator,
  s.last_trade_quantity,
  s.last_trade_time,
  s.average_trade_price / 100,
  s.total_buy_quantity,
  s.total_sell_quantity,
  s.book_type,
  s.bid_qty_1,
  s.bid_px_1 / 100,
  s.bid_ord_1,
  s.bid_qty_2,
  s.bid_px_2 / 100,
  s.bid_ord_2,
  s.bid_qty_3,
  s.bid_px_3 / 100,
  s.bid_ord_3,
  s.bid_qty_4,
  s.bid_px_4 / 100,
  s.bid_ord_4,
  s.bid_qty_5,
  s.bid_px_5 / 100,
  s.bid_ord_5,
  s.ask_qty_1,
  s.ask_px_1 / 100,
  s.ask_ord_1,
  s.ask_qty_2,
  s.ask_px_2 / 100,
  s.ask_ord_2,
  s.ask_qty_3,
  s.ask_px_3 / 100,
  s.ask_ord_3,
  s.ask_qty_4,
  s.ask_px_4 / 100,
  s.ask_ord_4,
  s.ask_qty_5,
  s.ask_px_5 / 100,
  s.ask_ord_5,
  s.effective_ts,
  s.updated_at
)

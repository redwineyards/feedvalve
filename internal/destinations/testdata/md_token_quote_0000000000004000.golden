MERGE INTO MD_TOKEN_QUOTE t
USING (SELECT
  :1 AS token,
  :2 AS bid_qty_1,
  :3 AS bid_px_1,
  :4 AS bid_ord_1,
  :5 AS bid_qty_2,
  :6 AS bid_px_2,
  :7 AS bid_ord_2,
  :8 AS bid_qty_3,
  :9 AS bid_px_3,
  :10 AS bid_ord_3,
  :11 AS bid_qty_4,
  :12 AS bid_px_4,
  :13 AS bid_ord_4,
  :14 AS bid_qty_5,
  :15 AS bid_px_5,
  :16 AS bid_ord_5,
  :17 AS ask_qty_1,
  :18 AS ask_px_1,
  :19 AS ask_ord_1,
  :20 AS ask_qty_2,
  :21 AS ask_px_2,
  :22 AS ask_ord_2,
  :23 AS ask_qty_3,
  :24 AS ask_px_3,
  :25 AS ask_ord_3,
  :26 AS ask_qty_4,
  :27 AS ask_px_4,
  :28 AS ask_ord_4,
  :29 AS ask_qty_5,
  :30 AS ask_px_5,
  :31 AS ask_ord_5,
  :32 AS updated_at
  FROM dual) s
ON (t.token = s.token)
WHEN MATCHED THEN UPDATE SET
  t.bid_qty_1 = s.bid_qty_1,
  t.bid_px_1 = s.bid_px_1 / 100,
  t.bid_ord_1 = s.bid_ord_1,
  t.bid_qty_2 = s.bid_qty_2,
  t.bid_px_2 = s.bid_px_2 / 100,
  t.bid_ord_2 = s.bid_ord_2,
  t.bid_qty_3 = s.bid_qty_3,
  t.bid_px_3 = s.bid_px_3 / 100,
  t.bid_ord_3 = s.bid_ord_3,
  t.bid_qty_4 = s.bid_qty_4,
  t.bid_px_4 = s.bid_px_4 / 100,
  t.bid_ord_4 = s.bid_ord_4,
  t.bid_qty_5 = s.bid_qty_5,
  t.bid_px_5 = s.bid_px_5 / 100,
  t.bid_ord_5 = s.bid_ord_5,
  t.ask_qty_1 = s.ask_qty_1,
  t.ask_px_1 = s.ask_px_1 / 100,
  t.ask_ord_1 = s.ask_ord_1,
  t.ask_qty_2 = s.ask_qty_2,
  t.ask_px_2 = s.ask_px_2 / 100,
  t.ask_ord_2 = s.ask_ord_2,
  t.ask_qty_3 = s.ask_qty_3,
  t.ask_px_3 = s.ask_px_3 / 100,
  t.ask_ord_3 = s.ask_ord_3,
  t.ask_qty_4 = s.ask_qty_4,
  t.ask_px_4 = s.ask_px_4 / 100,
  t.ask_ord_4 = s.ask_ord_4,
  t.ask_qty_5 = s.ask_qty_5,
  t.ask_px_5 = s.ask_px_5 / 100,
  t.ask_ord_5 = s.ask_ord_5,
  t.updated_at = s.updated_at
WHEN NOT MATCHED THEN INSERT (
  token,
  bid_qty_1,
  bid_px_1,
  bid_ord_1,
  bid_qty_2,
  bid_px_2,
  bid_ord_2,
  bid_qty_3,
  bid_px_3,
  bid_ord_3,
  bid_qty_4,
  bid_px_4,
  bid_ord_4,
  bid_qty_5,
  bid_px_5,
  bid_ord_5,
  ask_qty_1,
  ask_px_1,
  ask_ord_1,
  ask_qty_2,
  ask_px_2,
  ask_ord_2,
  ask_qty_3,
  ask_px_3,
  ask_ord_3,
  ask_qty_4,
  ask_px_4,
  ask_ord_4,
  ask_qty_5,
  ask_px_5,
  ask_ord_5,
  updated_at
)
VALUES (
  s.token,
  s.bid_qty_1,
  s.bid_px_1 / 100,
  s.bid_ord_1,
  s.bid_qty_2,
  s.bid_px_2 / 100,
  s.bid_ord_2,
  s.bid_qty_3,
  s.bid_px_3 / 100,
  s.bid_ord_3,
  s.bid_qty_4,
  s.bid_px_4 / 100,
  s.bid_ord_4,
  s.bid_qty_5,
  s.bid_px_5 / 100,
  s.bid_ord_5,
  s.ask_qty_1,
  s.ask_px_1 / 100,
  s.ask_ord_1,
  s.ask_qty_2,
  s.ask_px_2 / 100,
  s.ask_ord_2,
  s.ask_qty_3,
  s.ask_px_3 / 100,
  s.ask_ord_3,
  s.ask_qty_4,
  s.ask_px_4 / 100,
  s.ask_ord_4,
  s.ask_qty_5,
  s.ask_px_5 / 100,
  s.ask_ord_5,
  s.updated_at
)
